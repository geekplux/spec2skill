{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest", "unicorn"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "overrides": [{ "files": ["scripts/**/*.mjs", "src/skillgen/assets/**/*.mjs", "examples/**/*.mjs", "*.config.ts"], "env": { "node": true } }],
  "ignorePatterns": ["dist", "node_modules", "docs/screenshots", "docs/redesign/target", ".wrangler"]
}
