# Cloudflare Workers static assets: response headers (copied to dist/ by Vite; not served as a file).
# Hashed build output never changes, so browsers may keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell must always be revalidated so a new deploy is picked up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
