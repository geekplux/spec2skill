// One Worker with static assets (D1): Vite builds dist/, wrangler bundles worker/ (D2).
// Local: `pnpm build && pnpm dev:worker`. Deployment is prepared in phase 21 and needs Sean's approval.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spec2skill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 30 requests / 60 s per client IP for /api/fetch-spec and /api/mcp/tools (D19).
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
