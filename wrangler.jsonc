// One Worker with static assets (D1): Vite builds dist/, wrangler bundles worker/ (D2).
// Local: `pnpm build && pnpm dev:worker`. Deployment is prepared in phase 21 and needs Sean's approval.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spec2skill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 30 requests / 60 s per client IP for /api/fetch-spec and /api/mcp/tools (D19); 10 / 60 s for /api/ai/describe.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Optional lean AI (phase 17): cluster names and skill prose for user-loaded specs. Without the AI
  // binding, /api/ai/describe answers 501 and the app stays deterministic. No API key or secret is needed.
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8" },
  // AI results, 30-day TTL. The id is a placeholder: create the namespace with
  // `wrangler kv namespace create SPEC_CACHE` and paste its id here before deploying (phase 21 DEPLOY.md).
  "kv_namespaces": [{ "binding": "SPEC_CACHE", "id": "00000000000000000000000000000000" }],
  // `pnpm dev:worker` runs this env: Workers AI bindings always reach Cloudflare (login needed), so local
  // dev leaves AI out and the app stays deterministic, as without the binding in production.
  "env": {
    "local": {
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "AI_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8" },
      "kv_namespaces": [{ "binding": "SPEC_CACHE", "id": "00000000000000000000000000000000" }]
    }
  }
}
