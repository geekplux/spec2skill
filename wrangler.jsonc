// One Worker with static assets (D1): Vite builds dist/, wrangler bundles worker/ (D2).
// This file is PRODUCTION only (top level) plus the `previews` block for Workers Builds branch previews.
// Workers Builds runs `pnpm run build`, then `npx wrangler deploy` (no --env). Local dev uses wrangler.local.jsonc.
// Deploying: docs/DEPLOY.md (dry run: `pnpm run check:deploy`). No secrets live here or anywhere else.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spec2skill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Custom domain, also attached in the dashboard: declaring it here keeps `wrangler deploy` from removing it.
  "routes": [{ "pattern": "spec2skill.geekplux.com", "custom_domain": true }],
  // 30 requests / 60 s per client IP for /api/fetch-spec and /api/mcp/tools (D19); 10 / 60 s for /api/ai/describe;
  // PROXY_LIMITER: 300 / 60 s for the two proxies site-wide (one shared key). namespace_id must be unique in the
  // Cloudflare account: Workers that share one share counters, so this project uses 4xxx.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "4002", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROXY_LIMITER", "namespace_id": "4003", "simple": { "limit": 300, "period": 60 } }
  ],
  // Optional lean AI (phase 17): cluster names and skill prose for user-loaded specs. Without the AI
  // binding, /api/ai/describe answers 501 and the app stays deterministic. No API key or secret is needed.
  "ai": { "binding": "AI" },
  // DAILY_AI_CAP: model calls per UTC day for the whole site, counted in SPEC_CACHE (worker/budget.ts); past it
  // the app keeps its deterministic text. "0" switches AI off.
  "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8", "DAILY_AI_CAP": "300" },
  // AI results, 30-day TTL. Namespace id (docs/DEPLOY.md, step 2),
  // created with `pnpm exec wrangler kv namespace create SPEC_CACHE`.
  "kv_namespaces": [{ "binding": "SPEC_CACHE", "id": "b7d9422f1e0748e591bb18006fb87c38" }],
  // Workers Logs: invocation metadata and console output only (the Worker never logs request bodies);
  // query strings are redacted from logged URLs.
  "observability": { "enabled": true, "redact_query_string": true },
  // Workers Builds branch previews (`npx wrangler preview`) do not inherit the bindings above. Previews get
  // AI and their own rate-limit counters but no SPEC_CACHE (the cache is optional), so they never touch
  // production KV and need no second namespace id. Without KV there is nowhere to count DAILY_AI_CAP, so
  // previews never call the model either.
  "previews": {
    "ratelimits": [
      { "name": "RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
      { "name": "AI_RATE_LIMITER", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
      { "name": "PROXY_LIMITER", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
    ],
    "ai": { "binding": "AI" },
    "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8", "DAILY_AI_CAP": "300" }
  }
}
