// Local development only: `pnpm dev:worker` and `pnpm smoke:worker` run `wrangler dev -c wrangler.local.jsonc`.
// Same Worker as wrangler.jsonc minus the AI binding (Workers AI always reaches Cloudflare and needs a login),
// so local dev works offline and the app stays deterministic. KV is simulated locally, so its id is a dummy.
// Kept out of wrangler.jsonc so `wrangler deploy` there sees one environment and prints no warning.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spec2skill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": { "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8" },
  "kv_namespaces": [{ "binding": "SPEC_CACHE", "id": "00000000000000000000000000000000" }]
}
