{
  "skill": "tasks-api",
  "mode": "dry-run",
  "chain": [
    "listProjects",
    "listMembers",
    "getMember"
  ],
  "steps": [
    {
      "step": 1,
      "op": "listProjects",
      "destructive": false,
      "args": {},
      "request": {
        "method": "GET",
        "url": "https://tasks.example.com/v1/projects",
        "headers": {
          "authorization": "Bearer REDACTED"
        },
        "missingAuth": []
      },
      "fedBy": []
    },
    {
      "step": 2,
      "op": "listMembers",
      "destructive": false,
      "args": {
        "projectId": "<projectId>"
      },
      "request": {
        "method": "GET",
        "url": "https://tasks.example.com/v1/projects/%3CprojectId%3E/members",
        "headers": {
          "authorization": "Bearer REDACTED"
        },
        "missingAuth": []
      },
      "fedBy": [
        {
          "arg": "projectId",
          "from": "listProjects",
          "field": "id"
        }
      ]
    },
    {
      "step": 3,
      "op": "getMember",
      "destructive": false,
      "args": {
        "projectId": "<projectId>",
        "memberId": "<memberId>"
      },
      "request": {
        "method": "GET",
        "url": "https://tasks.example.com/v1/projects/%3CprojectId%3E/members/%3CmemberId%3E",
        "headers": {
          "authorization": "Bearer REDACTED"
        },
        "missingAuth": []
      },
      "fedBy": [
        {
          "arg": "memberId",
          "from": "listMembers",
          "field": "id"
        }
      ]
    }
  ]
}
