{
  "name": "spec2skill",
  "version": "0.0.0",
  "private": true,
  "description": "Turn any OpenAPI spec or MCP server into an agent skill in one click.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spec2skill": "dist-cli/spec2skill.mjs"
  },
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "vite build --config vite.config.cli.ts",
    "cli": "pnpm build:cli && node dist-cli/spec2skill.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev:worker": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "lint": "oxlint --deny-warnings && node scripts/check-spacing.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "check:browser": "node scripts/check-browser.mjs",
    "check:size": "node scripts/check-size.mjs",
    "gallery": "node scripts/build-gallery.mjs",
    "capture:readme": "node scripts/capture-readme.mjs && node scripts/social-preview.mjs",
    "capture:demo": "node scripts/capture-demo.mjs",
    "test:docs": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "fflate": "^0.8.3",
    "js-yaml": "^4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
